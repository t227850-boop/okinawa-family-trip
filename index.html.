<script>
function go(id,btn){
  document.getElementById(id).scrollIntoView({behavior:'smooth'});
  document.querySelectorAll('nav button').forEach(x=>x.classList.remove('active'));
  btn.classList.add('active');
}
function calc(){
  const y=parseFloat(document.getElementById('yen').value)||0;
  const r=parseFloat(document.getElementById('rate').value)||0;
  document.getElementById('nt').textContent='NT$'+Math.round(y*r).toLocaleString();
}
document.querySelectorAll('input[type=checkbox]').forEach(el=>{
  const k=el.dataset.key;
  if(k && localStorage.getItem(k)==='1') el.checked=true;
  el.addEventListener('change',()=>localStorage.setItem(k,el.checked?'1':'0'));
});
calc();

function setDay(n,btn){
  document.querySelectorAll('.day-tabs button').forEach(x=>x.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('progressBar').style.width=(n*25)+'%';
  const hints={
    1:'✈️ 抵達 → 🙏 達磨寺 → 😴 午睡北上 → 🏠 恩納',
    2:'🐠 美麗海 → 🍤 KOURI SHRIMP → 😴 午睡 → 🟠 Orion／購物',
    3:'🦒 兒童王國 → 😴 午睡 → 🐟 西銘 → 🥩 肉屋 → 🎆 北谷煙火',
    4:'🍱 鰻魚飯 → 🚗 還車 → 🛫 那霸機場 → ✈️ 16:45'
  };
  document.getElementById('dayHint').textContent=hints[n];
}
</script>
